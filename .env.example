# Copy to .env.local for local work; set the same names in Vercel -> Project Settings -> Environment Variables.
# Placeholders only - never commit real values.

# --- Email (Resend) - ALL THREE ARE REQUIRED; there are no fallbacks ---
# If any is missing, enquiry/lead/booking emails fail safely (HTTP 503) and the missing NAMES are logged.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Sender on a domain verified in Resend (SPF + DKIM). Free-mail and resend.dev senders are rejected.
EMAIL_FROM="DeosAI Labs <notifications@your-verified-domain.com>"
# Inbox that receives enquiries, bookings and Playbook leads. Must be set explicitly.
CONTACT_NOTIFY_EMAIL=info@deosailabs.com

# --- Scheduling (Cal.com) ---
# "username/event-slug" from your public booking URL, e.g. https://cal.com/deosailabs/discovery-call
NEXT_PUBLIC_CAL_LINK=your-username/discovery-call
# Secret you type into the Cal.com webhook form; used to verify x-cal-signature-256.
CAL_WEBHOOK_SECRET=generate-a-long-random-string

# --- Chat assistant ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- Optional: search engine verification meta tags ---
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
